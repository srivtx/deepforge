# Optional sync/social backend.
#
# Leave BOTH values unset (or delete these lines) and DeepForge runs fully local:
# no network calls, no account required, every feature works offline.
# Sync only activates when both are set and a Supabase session exists.
#
# The publishable key is safe to expose in the browser (RLS is the security boundary).
# Never put a service role key or the database password in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
